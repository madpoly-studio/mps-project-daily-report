# Cấu hình riêng của một project. Copy file này thành projects\<KEY>.env (không commit), vd projects\ART.env,
# rồi chạy: .\daily-report.ps1 -Project <KEY> -DryRun
# Key nào có trong file này (kể cả để trống) đều ghi đè key cùng tên trong .env chung, nên key tuỳ chọn
# không dùng thì để nguyên dạng comment, đừng để "KEY=" trống.
# Comment phải nằm trên dòng riêng (không viết comment sau giá trị).

# Mã project Jira. Không khai báo thì mặc định = <KEY> (tên file), vd projects\ART.env -> ART.
# JIRA_PROJECT=SH

# (Tuỳ chọn) id scrum board cho card tổng kết sprint, nhiều board cách nhau bằng dấu phẩy.
# Không khai báo thì tự tìm mọi scrum board của JIRA_PROJECT.
# JIRA_BOARD_ID=

# Danh sách repo GitLab dạng group/repo, cách nhau bằng dấu phẩy (vd: mps/sniper-hunting)
GITLAB_PROJECTS=<group>/<repo-client>,<group>/<repo-server>

# Workflow "Post to a channel when a webhook request is received" của channel Teams nhận báo cáo project này.
TEAMS_WEBHOOK_URL=<teams-channel-workflow-url>

# (Tuỳ chọn) trạng thái Jira tính là "done", cách nhau bằng dấu phẩy. Không khai báo thì mặc định Closed,Resolved,Done.
# JIRA_DONE_STATUSES=Closed,Resolved,Done
