# Cấu hình dùng chung cho mọi project. Copy file này thành .env (không commit) rồi điền giá trị thật.
# Phần riêng của từng project nằm ở projects\<KEY>.env (xem projects\example.env.sample);
# key nào trong file project cũng ghi đè được key cùng tên ở đây.
# KHÔNG đặt JIRA_PROJECT, JIRA_BOARD_ID, GITLAB_PROJECTS, TEAMS_WEBHOOK_URL ở đây (script báo lỗi);
# JIRA_DONE_STATUSES thì được, làm mặc định chung cho mọi project.
# Comment phải nằm trên dòng riêng (không viết comment sau giá trị).

# Jira Data Center + Personal Access Token
JIRA_URL=https://jira.example.com
JIRA_PERSONAL_TOKEN=<jira-personal-access-token>

# GitLab: host + PAT (scope read_api). PAT có hạn dùng, hết hạn thì báo cáo lỗi 401, nhớ thay.
# Để trống GITLAB_TOKEN thì glab dùng biến môi trường GITLAB_TOKEN của user, nếu không thì token từ glab auth login.
GITLAB_HOST=git-gst.mto.zing.vn
GITLAB_TOKEN=<gitlab-personal-access-token>

# Workflow của chat test: nhận card -Test và mọi card báo lỗi (của mọi project, tiêu đề có tiền tố [<KEY>]).
# Để trống thì lỗi chỉ ghi log.
TEAMS_TEST_WEBHOOK_URL=<teams-test-chat-workflow-url>
